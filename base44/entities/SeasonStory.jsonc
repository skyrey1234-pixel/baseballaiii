{
  "name": "SeasonStory",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "season": {
      "type": "string"
    },
    "cut_type": {
      "type": "string",
      "enum": [
        "team_documentary",
        "player_film",
        "recruiting_video",
        "social_clips",
        "senior_tribute"
      ],
      "default": "team_documentary"
    },
    "subject": {
      "type": "string",
      "description": "Player name for individual cuts, team name otherwise"
    },
    "logline": {
      "type": "string"
    },
    "runtime": {
      "type": "string"
    },
    "chapters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "beat": {
            "type": "string",
            "description": "The story turn this chapter delivers"
          },
          "narration": {
            "type": "string",
            "description": "Voiceover script for this chapter"
          },
          "footage": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Shots to pull, tied to real film or moments on record"
          },
          "music": {
            "type": "string"
          }
        }
      }
    },
    "highlight_moments": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "missing_footage": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Shots the team still needs to capture"
    }
  },
  "required": [
    "title",
    "cut_type"
  ]
}